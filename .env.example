# SETUAI V7 Environment Variables Example
# Copy to .env or backend/.env and populate with V7 credentials. Never commit real credentials.

# --- Database (Supabase PostgreSQL direct connection) ---
DATABASE_URL=postgresql://postgres:password@db.your-v7-project.supabase.co:5432/postgres

# --- Supabase Auth & Core ---
SUPABASE_URL=https://<V7-PROJECT-REF>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://<V7-PROJECT-REF>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
AUTH_DEV_MODE=false

# --- Storage Configuration ---
STORAGE_EVIDENCE_BUCKET=evidence
STORAGE_DOCUMENTS_BUCKET=documents

# --- AI / LLM Configuration ---
LLM_PROVIDER=groq
LLM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
EXTRACTION_FALLBACK=rules

# --- Network & Integrations ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
P6_BASE_URL=http://127.0.0.1:8000/api/v1/mock-p6
