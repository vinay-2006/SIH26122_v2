# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Database (Supabase Postgres, direct connection — M6 sets up the shared project) ---
# Get this from Supabase dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Supabase Auth ---
SUPABASE_URL=https://<PROJECT-REF>.supabase.co

# Publishable key (Supabase dashboard: SUPABASE_PUBLISHABLE_KEY or SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY=

# Secret key (Supabase dashboard: SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWKS URL for asymmetric JWT verification (ES256)
SUPABASE_JWKS_URL=https://<PROJECT-REF>.supabase.co/auth/v1/.well-known/jwks.json

# Optional: legacy JWT secret for offline HMAC-SHA256 token verification
# Leave empty when using JWKS verification (do NOT put JWKS URL here).
SUPABASE_JWT_SECRET=

# Enables the unsigned-JWT fallback in shared/auth.py's decode_supabase_jwt()
# (trusts a token's `sub` claim with no signature check) ONLY when none of
# SUPABASE_JWT_SECRET/SUPABASE_JWKS_URL/SUPABASE_URL+key are set either.
# Never set true outside local dev without a live Supabase project — the
# default is false so a deployment that simply forgot to configure Supabase
# auth fails closed (401) instead of silently accepting any token.
AUTH_DEV_MODE=false

# --- Storage configuration ---
STORAGE_EVIDENCE_BUCKET=evidence
STORAGE_DOCUMENTS_BUCKET=documents

# --- LLM configuration ---
# Groq primary, Gemini fallback
LLM_PROVIDER=groq
# Generic provider key:
LLM_API_KEY=
# Dedicated provider keys (take precedence for each provider):
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# To fail over to Gemini instead, without touching code:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-3.6-flash

# Deterministic fallback when the LLM provider is down / quota-exhausted (PRD v6 Section 21).
# 'rules' = conservative regex extraction (leaves gaps -> Feature 29 clarification asks the
# engineer); unset = fail with 502 instead. Recommended for demos on free-tier keys.
EXTRACTION_FALLBACK=rules

# Vision-capable model used for image/scanned-diary claim intake
# (POST /api/v1/claims/file with a .jpg/.jpeg/.png). Gemini Flash is
# natively multimodal, so LLM_PROVIDER=gemini needs no separate vision
# model. Groq's vision-capable model lineup isn't guaranteed present on
# every account -- leave this unset to get a clear, actionable error on an
# image upload instead of a guessed model name that silently 404s or
# ignores the image; set it once your Groq account has a vision model.
# LLM_VISION_MODEL=

# --- P6 EPPM REST Integration ---
# Demo default: the local mock P6 endpoint served by this same backend
# (POST /api/v1/mock-p6/activities/{id}; inspect with GET /api/v1/mock-p6/received).
# Leave empty to disable network write-back. No live OIL P6 access is required.
P6_BASE_URL=http://127.0.0.1:8000/api/v1/mock-p6

# --- Optional: Demo Supabase Auth user IDs ---
# Used by canonical seed data.
DEMO_SITE_ENGINEER_USER_ID=
DEMO_SUPERVISOR_USER_ID=

# --- Project site GPS configuration - owned by M4 ---
PROJECT_SITE_LAT=27.4728
PROJECT_SITE_LON=95.3547
PROJECT_SITE_RADIUS_KM=5.0

# --- CORS (comma-separated origins allowed to call this API) ---
# Defaults to the Vite dev server if unset; no need to set this for local dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173