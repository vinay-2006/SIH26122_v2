VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
# Explicit demo-only switch. Omit or set false for real backend data.
VITE_USE_MOCKS=false

# ---- v2 backend mode (see docs/V2_FRONTEND.md). Normally selected with `npm run dev:v2` / `npm run build:v2`, which set VITE_BACKEND=v2 for you.
# VITE_V2_API_BASE_URL=http://127.0.0.1:8020
# VITE_V2_LOCAL_LOGIN=true   # show the seeded demo people as sign-in shortcuts (email only; the server must also enable local sign-in)

# Deployment ceiling for one upload, in MB. Vercel refuses request bodies above 4.5 MB before the API sees them, so a Vercel build sets 4 and the app tells the user up front.
# VITE_MAX_UPLOAD_MB=4
